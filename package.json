    "framer-motion": "^11.3.8",
    "geist": "^1.3.1",
    "next": "^16.2.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.1.3",
    "sonner": "^2.0.7",
    "three": "^0.166.1"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
